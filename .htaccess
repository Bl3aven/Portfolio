########################################
# OVH STARTER SAFE ROOT .HTACCESS
########################################

# ==========================
# 1. FORCE HTTPS
# ==========================
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ==========================
# 2. DISABLE DIRECTORY LISTING
# ==========================
Options -Indexes

# ==========================
# 3. BLOCK SENSITIVE FILES
# ==========================
<FilesMatch "(^|/)\.(env|git|htaccess|htpasswd)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(bak|backup|old|sql|zip|tar\.gz|tgz|log|md|lock|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|ACCES_ACTUELS\.md)$">
  Require all denied
</FilesMatch>
# Block backup HTML and temporary files at root
<FilesMatch "^index_backup">
  Require all denied
</FilesMatch>

# ==========================
# 4. SECURITY HEADERS
# ==========================
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
# X-XSS-Protection is deprecated in modern browsers but kept for legacy
Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType model/stl .stl
AddType image/svg+xml .svg
</IfModule>

# ==========================
# 5. HOTLINK PROTECTION (IMAGES ONLY)
# ==========================
<IfModule mod_rewrite.c>
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://(www\.)?tournayre\.ovh/ [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,L]
</IfModule>

# ==========================
# 6. CACHE STATIC FILES
# ==========================
<IfModule mod_expires.c>
ExpiresActive On

ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresDefault "access plus 2 days"
</IfModule>

# ==========================
# 7. CUSTOM ERROR PAGES
# ==========================
ErrorDocument 404 /404.html

# ==========================
# 8. NO-CACHE FOR DYNAMIC CONTENT
# ==========================
<FilesMatch "^content\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </IfModule>
</FilesMatch>

########################################
# END ROOT .HTACCESS
########################################
